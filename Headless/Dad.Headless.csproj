<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>dad</RootNamespace>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Configuration.cs;../PluginInfo.cs;../Models/*.cs;../Services/*.cs" />
    <Compile Remove="../Services/DadIpcService.cs" />
    <Reference Include="Dalamud;Dalamud.Common;Dalamud.Bindings.ImGui;FFXIVClientStructs;InteropGenerator.Runtime;Lumina;Lumina.Excel;Serilog;Newtonsoft.Json;System.Reactive">
      <HintPath>$(DalamudLibPath)%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Dad.AutoParty.Protocol" Version="[0.2.0-preview.8]" />
    <PackageReference Include="ECommons" Version="[3.2.1.15]" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="[10.0.10]" />
  </ItemGroup>
</Project>
