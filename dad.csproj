<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.6.0.3</Version>
    <FileVersion>0.6.0.3</FileVersion>
    <AssemblyVersion>0.6.0.3</AssemblyVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <RootNamespace>dad</RootNamespace>
    <AssemblyName>dad</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="backups\**" />
    <Compile Remove="**\backups\**" />
    <Compile Remove="Tests\**" />
    <None Remove="backups\**" />
    <None Remove="**\backups\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="dad.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dad.AutoParty.Protocol" Version="[0.2.0-preview.8]" />
    <PackageReference Include="ECommons" Version="[3.2.1.15]" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="[10.0.10]" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <PropertyGroup>
      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />
    <MakeDir Directories="$(DadDevPluginOutput)" Condition="'$(DadDevPluginOutput)' != ''" />
    <RemoveDir Directories="$(DadDevPluginOutput)\bin" Condition="'$(DadDevPluginOutput)' != '' and Exists('$(DadDevPluginOutput)\bin')" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).json" />
      <PluginFiles Include="images\icon.png" />
      <PluginRuntimeFiles Include="$(TargetDir)BouncyCastle.Cryptography.dll" Condition="Exists('$(TargetDir)BouncyCastle.Cryptography.dll')" />
      <PluginRuntimeFiles Include="$(TargetDir)AutoParty.Contracts.dll" Condition="Exists('$(TargetDir)AutoParty.Contracts.dll')" />
      <PluginRuntimeFiles Include="$(TargetDir)AutoParty.Core.dll" Condition="Exists('$(TargetDir)AutoParty.Core.dll')" />
      <PluginRuntimeFiles Include="$(TargetDir)ECommons.dll" Condition="Exists('$(TargetDir)ECommons.dll')" />
      <PluginRuntimeFiles Include="$(TargetDir)System.Formats.Cbor.dll" Condition="Exists('$(TargetDir)System.Formats.Cbor.dll')" />
      <PluginRuntimeFiles Include="$(TargetDir)System.Interactive.Async.dll" Condition="Exists('$(TargetDir)System.Interactive.Async.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutput)" />
    <Copy SourceFiles="@(PluginRuntimeFiles)" DestinationFolder="$(PluginOutput)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(DadDevPluginOutput)" Condition="'$(DadDevPluginOutput)' != ''" />
    <Copy SourceFiles="@(PluginRuntimeFiles)" DestinationFolder="$(DadDevPluginOutput)" SkipUnchangedFiles="true" Condition="'$(DadDevPluginOutput)' != ''" />
  </Target>
</Project>
