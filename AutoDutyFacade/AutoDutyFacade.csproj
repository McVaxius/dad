<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.0.0.19</Version>
    <FileVersion>0.0.0.19</FileVersion>
    <AssemblyVersion>0.0.0.19</AssemblyVersion>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <RootNamespace>AutoDutyFacade</RootNamespace>
    <AssemblyName>AutoDuty</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="AutoDuty.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <PropertyGroup>
      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>
      <DadDevPluginOutput>D:\temp\dad\$(AssemblyName)</DadDevPluginOutput>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />
    <MakeDir Directories="$(DadDevPluginOutput)" />
    <RemoveDir Directories="$(DadDevPluginOutput)\bin" Condition="Exists('$(DadDevPluginOutput)\bin')" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).json" />
      <PluginFiles Include="$(ProjectDir)..\images\icon.png" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutput)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(DadDevPluginOutput)" />
  </Target>
</Project>
